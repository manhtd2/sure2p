# Dead route files (2026-11-16): superseded by the consolidated dynamic
# routes api/auth/[group]/[action].ts, api/auth/[group].ts,
# api/invitations/[id].ts (see DEPLOY_VERCEL.md troubleshooting).
# They stay in git for history but must NOT be deployed: the Vercel Hobby
# plan allows at most 12 Serverless Functions per deployment, and with
# these files the count was 14 (build error
# exceeded_serverless_functions_per_deployment). Delete them from the repo
# when convenient — then remove these lines too. Note: dynamic segments in
# the same api/ directory must share a name, or the build fails with
# conflicting_file_path — that is why the consolidated files are named
# [group] and [id], not [action].
api/auth/otp/\[action\].ts
api/auth/wallet/\[action\].ts
api/invitations/claim.ts
api/invitations/peek.ts
api/auth/\[action\].ts
api/invitations/\[action\].ts
# Flattened routes (2026-11-17): the app now calls the parent path with
# ?action= / ?evidenceId= / ?txHash= instead of these nested paths
# (see the "Flattened alias" routes in server/routes/*). These files stay
# in git for history but must NOT be deployed, or the count goes back over
# the 12-function Hobby limit (was 16, now 11).
api/invitations/\[id\]/revoke.ts
api/admin/cases/\[publicId\]/\[action\].ts
api/transactions/\[publicId\]/evidence/\[evidenceId\].ts
api/drafts/\[id\]/\[action\].ts
api/transactions/\[publicId\]/tx/\[txHash\].ts
