# Browser-visible public configuration (safe to expose)
VITE_SURE2P_ESCROW_ADDRESS=
VITE_ACCOUNT_REGISTRY_ADDRESS=
# Transaction that deployed the escrow. The indexer starts scanning from its block.
VITE_SURE2P_ESCROW_DEPLOY_TX=

# Server and ops only. Never prefix these with VITE_.
API_PORT=8787
# Local dev only: the SQLite file. On Vercel set TURSO_DATABASE_URL instead
# (see below); the file is never the primary store on Vercel.
DATABASE_PATH=server/data/sure2p.sqlite
NODE_ENV=development
# "mock" is the only provider in this build and is refused when NODE_ENV=production,
# unless DEMO_ALLOW_MOCK_OTP=true (demo deployments only — anyone who can guess
# a phone number can sign in, because the code is returned by the API).
OTP_PROVIDER=mock
DEMO_ALLOW_MOCK_OTP=false
# Persistent database for Vercel (Turso libSQL, same SQLite schema).
# Local dev: leave unset to use DATABASE_PATH. Vercel: libsql://<db>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Secret for the Vercel Cron indexer endpoint (Authorization: Bearer <CRON_SECRET>).
# If unset, the cron endpoint runs without authentication — always set it.
CRON_SECRET=
# Serverless indexer tuning: gap between lazy (request-triggered) sync passes,
# and the max time an API request waits for one before serving the last indexed state.
INDEXER_LAZY_MIN_INTERVAL_MS=15000
INDEXER_LAZY_TIMEOUT_MS=8000
# Generated automatically into server/data for local development. Required in production.
SESSION_SECRET=
PHONE_ENCRYPTION_KEY=
# Extra allowed browser origins (comma separated), for deployments outside Arc Studio.
APP_ORIGIN=
# Blocks to wait before the indexer treats a block as final.
INDEXER_CONFIRMATIONS=1
# Optional per-chain RPC override. Without it the public Arc Testnet RPC is used.
RPC_URL_Arc_Testnet=

# Provisioned by Arc Studio inside its sandbox. Optional elsewhere.
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=
